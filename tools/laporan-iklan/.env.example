# ── tools/laporan-iklan/.env ──────────────────────────────────────────────
# SALIN file ini jadi ".env" (tanpa .example) lalu isi nilainya.
# .env TIDAK di-commit (sudah masuk .gitignore). Jangan pernah share isinya.

# ── Meta Marketing API ──
# System User access token (permanen). Cara ambil: lihat README.md bagian 1.
META_ACCESS_TOKEN=

# ID akun iklan Lovamily (tanpa prefix "act_"). Default sudah benar.
META_AD_ACCOUNT_ID=2260765378091626

# Versi Graph API (boleh dibiarkan).
META_GRAPH_VERSION=v21.0

# ── Telegram ──
# Bot token dari @BotFather (format: 123456789:ABC-DEF...).
TELEGRAM_BOT_TOKEN=

# Chat ID tujuan. Grup diawali tanda minus, mis. -1001234567890.
# Cara dapat: lihat README.md bagian 2.
TELEGRAM_CHAT_ID=

# ── Ambang playbook (opsional — biarkan kosong untuk pakai default) ──
# AMBANG_KILL_SPEND=75000
# AMBANG_WATCH_CPR=60000
# AMBANG_OK_CPR=40000
